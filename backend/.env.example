# ==========================================
# FastAPI Backend Configuration
# ==========================================

# The URL for the n8n webhook that will orchestrate the LLM call.
# In production, this should be the live n8n webhook URL.
# In local development, it might look like http://localhost:5678/webhook/analyze
N8N_WEBHOOK_URL=http://localhost:5678/webhook/analyze-sentiment

# Note: The backend NEVER contains the LLM API keys directly.
# Those are configured securely inside the n8n environment to maintain clean architectural separation.
